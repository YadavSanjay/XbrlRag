# XbrlRag environment template (WS-6 / B7). Copy to `.env` and fill in.
# `.env` is git-ignored and blocked from edits by the H2 secret guard.
# The project was formerly ARag: a legacy `ARAG_<X>` setting is still read as
# `XBRLRAG_<X>` (the new name wins when both are set).

# --- LLM providers ---
# Each key may instead come from a mounted file: <VAR>_FILE=/run/secrets/<name>.
OPENAI_API_KEY=
# OPENAI_API_KEY_FILE=
# Needed only when the active LLM profile uses Claude (e.g. XBRLRAG_LLM_PROFILE=anthropic).
ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_FILE=
# Needed only for the deepseek development profile (XBRLRAG_LLM_PROFILE=deepseek).
DEEPSEEK_API_KEY=
# DEEPSEEK_API_KEY_FILE=
JINA_API_KEY=
# LLM profile from configs/llm/llm.yaml: openai (default when empty), openai-5.6, anthropic,
# or deepseek (development runs only).
XBRLRAG_LLM_PROFILE=

# --- Deploy mode (selects backends/policies, not endpoints) ---
# local (default) => filesystem for filings, sslmode=prefer on Postgres.
# aws             => S3 for filings, sslmode=require on Postgres (RDS).
# XBRLRAG_DEPLOY_MODE=local

# --- Fact store (Postgres xbrl_db) ---
XBRL_DB_HOST=localhost
XBRL_DB_PORT=5432
XBRL_DB_NAME=xbrl_db
XBRL_DB_USER=postgres
XBRL_DB_PASSWORD=postgres
# libpq sslmode. Unset => derived from deploy mode (prefer local / require aws).
# Belt-and-suspenders on AWS: the process-level PGSSLMODE env also forces TLS.
# XBRL_DB_SSLMODE=require

# --- Vector store (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
# For an in-VPC Qdrant fronted by TLS / an API key (AWS):
# QDRANT_API_KEY=
# QDRANT_HTTPS=false

# --- SEC EDGAR ---
# EDGAR mandates a contactable "Name email@domain" User-Agent, and rate-limits and
# blocks per identity. REQUIRED for downloads: there is no built-in default, and the
# downloader fails at startup without one. Overrides the YAML `identity:` key and is
# itself overridden by --identity.
# SEC_EDGAR_IDENTITY=Your Name you@example.com
# Read timeout for EDGAR requests, in seconds (default 120; edgartools' own is 30).
# Anything but a positive number stops the downloader at startup.
# XBRLRAG_EDGAR_READ_TIMEOUT_S=120

# --- frontier_sec_tools eval arm (docs/specs/frontier-sec-tools.md) ---
# Uses SEC_EDGAR_IDENTITY above. Responses are kept in a dated snapshot under
# <XBRLRAG_SEC_SNAPSHOT_DIR>/<as_of>/ (unset => data/frontier_sec_snapshots).
# XBRLRAG_SEC_SNAPSHOT_DIR=
# The date the arm's tools treat as today, set to the corpus's date; run_suite.py --sec-as-of
# sets it for a run, and the arm refuses to start without one.
# XBRLRAG_SEC_AS_OF=2026-10-29
# 1 => a strict rerun: a URL the snapshot does not hold is not fetched (not_in_snapshot).
# XBRLRAG_SEC_FROZEN=0
# Extra CIKs to withhold, comma-separated, on top of the committed held-out pool.
# XBRLRAG_SEC_WITHHELD_CIKS=

# --- Filing storage (ingest side only; deploy_mode=aws => S3) ---
# Local FS root for downloaded filings (unset => the historical data/ path).
# SEC_EDGAR_ROOT=
# XBRLRAG_STORAGE_BACKEND=local        # local | s3 (overrides the deploy-mode default)
# XBRLRAG_S3_BUCKET=                    # required when storage backend is s3
# XBRLRAG_S3_PREFIX=                    # optional key prefix within the bucket

# --- Shared inference (BGE-M3 + Jina) ---
# Set so the slim serving image reaches models over HTTP instead of loading them.
# In the compose `raginference` profile this is http://raginference:8799
RAGINFER_URL=
# Rerank score cache of the html_rag arm. Share one file across worktrees by setting this.
# XBRLRAG_HTML10K_RERANK_CACHE=data/cache/html10k_rerank.sqlite3

# --- Optional controls (see docs/harness/UNATTENDED_RUNS.md) ---
XBRLRAG_QUERY_CACHE=0
# XBRLRAG_RUN_MAX_COST_USD=
# XBRLRAG_LLM_RPM=
# XBRLRAG_LLM_TPM=
# Legacy switch: 1 = the openai-5.6 profile when XBRLRAG_LLM_PROFILE is empty
# XBRLRAG_USE_REPLACEMENT_MODELS=

# --- Monitoring profile ---
GRAFANA_PASSWORD=admin

# --- raginference profile ---
# RAGINFER_IMAGE=raginference:local
